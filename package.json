{
  "name": "navsentinel",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-extension.mjs",
    "build:research-reputation": "node scripts/build-extension.mjs research-reputation",
    "watch": "vite build --watch",
    "verify:versions": "node scripts/check_versions.mjs",
    "lint": "eslint extension/src/ tests/",
    "lint:fix": "eslint extension/src/ tests/ --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:regression": "playwright test --project=regression",
    "test:e2e:rollback": "playwright test -c playwright.rollback.config.ts",
    "test:e2e:live": "playwright test -c playwright.live.config.ts",
    "test:e2e:stress": "playwright test -c playwright.stress.config.ts",
    "test:e2e:corpus": "playwright test -c playwright.corpus.config.ts",
    "demo:showcase": "node scripts/run_demo.mjs core",
    "demo:showcase:operator": "node scripts/run_demo.mjs operator",
    "demo:showcase:recovery": "node scripts/run_demo.mjs recovery",
    "demo:showcase:record": "node scripts/run_demo.mjs core --record",
    "package:ext": "npm run check:mv3-worker && npm run check:content-loader && node scripts/package.mjs",
    "gym:serve": "vite gym --port 5173 --strictPort",
    "update:psl": "node scripts/update-psl.mjs",
    "measure:fp": "node scripts/measure-fp.mjs",
    "build:bloom": "node scripts/build-bloom-filter.mjs",
    "build:bloom:test": "node scripts/build-test-bloom-filter.mjs",
    "build:topsites": "node scripts/build-topsites-tier.mjs",
    "check:topsites": "node scripts/build-topsites-tier.mjs --check",
    "check:bloom-size": "node scripts/check-bloom-size.mjs",
    "check:bloom-real": "node scripts/check-bloom-real.mjs",
    "check:release-profile": "node scripts/check-release-profile.mjs",
    "security:import": "node scripts/security-program/import-defense-vectors.mjs",
    "security:generate": "node scripts/security-program/generate-views.mjs",
    "security:check": "node scripts/security-program/validate-registry.mjs && node scripts/security-program/generate-views.mjs --check",
    "security:check:source": "node scripts/security-program/validate-registry.mjs --require-source && node scripts/security-program/generate-views.mjs --check",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "release:dry": "node scripts/release.mjs patch --dry-run",
    "benchmark": "node scripts/benchmark.mjs",
    "check:perf-budget": "node scripts/check-perf-budget.mjs",
    "check:content-loader": "node scripts/check-content-loader-identity.mjs",
    "check:mv3-worker": "node scripts/check-mv3-worker-imports.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.0",
    "@types/chrome": "^0.0.260",
    "@types/node": "^20.19.37",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "es-module-lexer": "^2.1.0",
    "eslint": "^10.9.1",
    "fast-check": "^4.6.0",
    "happy-dom": "^20.9.0",
    "playwright": "^1.49.0",
    "sharp": "^0.35.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.2.2",
    "vitest": "^4.1.7"
  }
}
