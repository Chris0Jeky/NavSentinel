{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(pwd)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git stash*)",
      "Bash(git rebase --abort*)",
      "Bash(git rebase --continue*)",
      "Bash(git rebase --skip*)",
      "Bash(git merge --abort*)",
      "Bash(rg *)",
      "Bash(npm run verify:versions*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run test*)",
      "Bash(npm run build*)",
      "Bash(npm run package:ext*)",
      "Bash(npm run gym:serve*)",
      "Bash(npm run agent:*)",
      "Bash(node scripts/package.mjs*)",
      "Bash(python scripts/agent_hooks/render_failure_ledger.py*)",
      "Bash(python scripts/agent_hooks/smoke_test.py*)",
      "Bash(python scripts/agent_hooks/validate_skills.py*)",
      "Bash(python .claude/hooks/smoke_test.py*)",
      "Bash(python -m py_compile scripts/agent_hooks/*.py*)"
    ],
    "deny": [
      "Bash(npm publish*)",
      "Bash(chrome-webstore-upload*)",
      "Bash(web-ext sign*)",
      "Bash(git filter-branch*)",
      "Bash(chmod -R 777 *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "python \"$env:CLAUDE_PROJECT_DIR\\scripts\\agent_hooks\\session_start.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\dispatch.py\" --event pre",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "python \"$env:CLAUDE_PROJECT_DIR\\scripts\\agent_hooks\\post_tool_use.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "python \"$env:CLAUDE_PROJECT_DIR\\scripts\\agent_hooks\\post_tool_failure.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
