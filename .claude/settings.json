{
  "permissions": {
    "defaultMode": "ask",
    "allow": [
      "Read(*)",
      "Grep(*)",
      "Glob(*)",
      "LS(*)",
      "Bash(pwd)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(rg *)",
      "Bash(npm run verify:versions*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run test*)",
      "Bash(npm run build*)",
      "Bash(npm run package:ext*)",
      "Bash(npm run gym:serve*)",
      "Bash(node scripts/package.mjs*)",
      "Bash(python scripts/agent_hooks/render_failure_ledger.py*)",
      "Bash(python -m py_compile scripts/agent_hooks/*.py*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git clean -fx*)",
      "Bash(git push --force*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git checkout -- *)",
      "Bash(git restore .*)",
      "Bash(sudo *)",
      "Bash(chmod -R 777 *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(npm publish*)",
      "Bash(*.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/agent_hooks/pre_tool_use.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/agent_hooks/post_tool_failure.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
