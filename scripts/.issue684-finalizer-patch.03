def main() -> None:
    if len(sys.argv) != 2 or sys.argv[1] not in {"tests", "production"}:
        raise SystemExit("usage: issue684_finalizer_patch.py tests|production")
    if sys.argv[1] == "tests":
        patch_contract_tests()
    else:
        patch_production()


if __name__ == "__main__":
    main()
