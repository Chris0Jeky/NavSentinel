#!/usr/bin/env python3
from __future__ import annotations

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def replace_once(text: str, old: str, new: str, label: str) -> str:
    count = text.count(old)
    if count != 1:
        raise RuntimeError(f"{label}: expected one match, found {count}")
    return text.replace(old, new, 1)


def regex_replace_once(
    text: str,
    pattern: str,
    replacement: str,
    label: str,
) -> str:
    updated, count = re.subn(pattern, replacement, text, count=1, flags=re.S)
    if count != 1:
        raise RuntimeError(f"{label}: expected one match, found {count}")
    return updated


def append_once(path: Path, marker: str, addition: str) -> None:
    text = path.read_text(encoding="utf-8")
    if marker in text:
        return
    path.write_text(text.rstrip() + "\n\n" + addition.strip() + "\n", encoding="utf-8")


CONTRACT_TEST = r'''

  it("keeps authoritative receipt issuance in the committed launcher", () => {
    const launcher = fs.readFileSync(
      path.join(repositoryRoot, "scripts", "run-state-authority-campaign.mjs"),
      "utf8",
    );
    const campaign = fs.readFileSync(
      path.join(repositoryRoot, "tests", "e2e", "state-authority-sink.spec.ts"),
      "utf8",
    );

    expect(campaign).toContain('authority: "playwright-candidate-only"');
    expect(campaign).toContain("launcher_finalized: false");
    expect(campaign).not.toContain("testInfo.attach(");
    expect(campaign).not.toContain('authority: "committed-launcher-finalized"');
    expect(campaign).not.toContain("NAVSENTINEL_STATE_AUTHORITY_FINALIZATION_KEY");

    expect(launcher).toContain("function finalizeCandidateReceipts");
    expect(launcher).toContain('authority: "committed-launcher-finalized"');
    expect(launcher).toContain("finalized_after_child_exit: true");
    expect(launcher).toContain("const finalizationKey = randomBytes(32)");
    expect(launcher).toContain("finalization_key_commitment_sha256");
    expect(launcher).not.toContain(
      "childEnvironment.NAVSENTINEL_STATE_AUTHORITY_FINALIZATION_KEY",
    );
  });
'''


def patch_contract_tests() -> None:
    target = ROOT / "tests/state-authority-launcher-contract.test.ts"
    text = target.read_text(encoding="utf-8")
    text = replace_once(
        text,
        "      schemaVersion: 2,\n      mode: \"non-consumable-preflight-summary\",",
        "      schemaVersion: 3,\n      mode: \"non-consumable-preflight-summary\",",
        "preflight summary schema",
    )
    text = replace_once(
        text,
        "    expect(summary.campaignExecutionRoot).toBeUndefined();\n",
        "    expect(summary.campaignExecutionRoot).toBeUndefined();\n"
        "    expect(summary.candidateReceiptDirectory).toBeUndefined();\n"
        "    expect(summary.finalizationKeyCommitment).toBeUndefined();\n",
        "preflight secret assertions",
    )
    if "keeps authoritative receipt issuance in the committed launcher" not in text:
        closing = text.rfind("\n});")
        if closing < 0:
            raise RuntimeError("launcher contract closing describe not found")
        text = text[:closing] + CONTRACT_TEST + text[closing:]
    target.write_text(text, encoding="utf-8")


CANDIDATE_DIRECTORY_HELPER = r'''
function resolveCandidateReceiptDirectory(configured: string): string {
  const requested = path.resolve(configured);
  let stats: fs.Stats;
  try {
    stats = fs.lstatSync(requested);
  } catch (error) {
    throw launchIntegrityError(
      "CANDIDATE_DIRECTORY",
      `candidate receipt directory is unavailable: ${
        error instanceof Error ? error.message : String(error)
      }`,
    );
  }
  if (stats.isSymbolicLink() || !stats.isDirectory()) {
    throw launchIntegrityError(
      "CANDIDATE_DIRECTORY",
      "candidate receipt path is linked or not an ordinary directory",
    );
  }
  if (process.platform !== "win32" && (stats.mode & 0o077) !== 0) {
    throw launchIntegrityError(
      "CANDIDATE_DIRECTORY",
      "candidate receipt directory permissions are too broad",
    );
  }
  const realDirectory = fs.realpathSync.native(requested);
  if (!sameNativePath(requested, realDirectory)) {
    throw launchIntegrityError(
      "CANDIDATE_DIRECTORY",
      "candidate receipt directory resolves through a link",
    );
  }
  for (const forbiddenRoot of [repositoryRoot, campaignExecutionRoot]) {
    const relative = path.relative(forbiddenRoot, realDirectory);
    if (
      relative === ""
      || (
        !relative.startsWith(`..${path.sep}`)
        && relative !== ".."
        && !path.isAbsolute(relative)
      )
    ) {
      throw launchIntegrityError(
        "CANDIDATE_DIRECTORY",
        "candidate receipt directory must be outside repository and campaign trees",
      );
    }
  }
  return realDirectory;
}
'''

CANDIDATE_WRITER = r'''
function writeReceiptCandidate(
  scenario: ScenarioDefinition,
  observations: ArmObservation[],
  browserVersion: string,
): void {
  if (!launchAttestation || !extensionProvenance) {
    throw new Error("External launch and current-head extension provenance were not established.");
  }
  const currentSnapshot = assertLaunchSnapshotCurrent(launchAttestation);
  const currentBuildInputs = currentSnapshot.buildInputs;
  expect(
    currentSnapshot.campaignExecutedSha256,
    "Campaign sources must match raw committed bytes",
  ).toBe(currentSnapshot.campaignGitSha256);
  expect(currentBuildInputs.repositoryCommit, "Repository head must not change after the build").toBe(
    extensionProvenance.repositoryHead,
  );
  expect(currentBuildInputs.repositoryTree, "Repository tree must not change after the build").toBe(
    extensionProvenance.repositoryTree,
  );
  expect(currentBuildInputs.objectFormat).toBe(extensionProvenance.objectFormat);
  expect(currentBuildInputs.comparisonMode).toBe(extensionProvenance.comparisonMode);
  expect(currentBuildInputs.gitSha256).toBe(extensionProvenance.gitSourceSha256);
  expect(currentBuildInputs.executedSha256).toBe(extensionProvenance.executedSourceSha256);
  const currentBuildOutput = assertExtensionBuildOutputHash(
    repositoryRoot,
    extensionPath,
    extensionProvenance.buildOutput,
  );
  const candidate = {
    schema_version: 1,
    authority: "playwright-candidate-only",
    launcher_finalized: false,
    launch_run_id: launchAttestation.runId,
    finalization_key_commitment_sha256:
      launchAttestation.finalizationKeyCommitment,
    extension_build_sha256: currentBuildOutput.sha256,
    extension_build_file_count: currentBuildOutput.fileCount,
    campaign_materialized_sha256:
      currentSnapshot.campaignMaterializedSha256,
    scenario_id: scenario.id,
    journey: scenario.rw,
    model: scenario.label,
    browser: `Playwright bundled Chromium ${browserVersion}`,
    observations,
  };
  const candidatePath = path.join(
    launchAttestation.candidateReceiptDirectory,
    `${scenario.rw.toLowerCase()}-state-authority-candidate.json`,
  );
  fs.writeFileSync(
    candidatePath,
    `${JSON.stringify(candidate, null, 2)}\n`,
    { encoding: "utf8", mode: 0o600, flag: "wx" },
  );
  if (process.platform !== "win32") fs.chmodSync(candidatePath, 0o600);
}
'''


def patch_spec() -> None:
    target = ROOT / "tests/e2e/state-authority-sink.spec.ts"
    text = target.read_text(encoding="utf-8")
    text = replace_once(text, "  type TestInfo,\n", "", "remove TestInfo import")
    text = replace_once(
        text,
        "  schemaVersion: 2;",
        "  schemaVersion: 3;",
        "attestation type schema",
    )
    text = replace_once(
        text,
        "  campaignExecutionRoot: string;\n  repositoryCommit: string;",
        "  campaignExecutionRoot: string;\n"
        "  candidateReceiptDirectory: string;\n"
        "  repositoryCommit: string;",
        "candidate directory attestation type",
    )
    text = replace_once(
        text,
        "  manifestOid: string;\n  issuedAt: string;",
        "  manifestOid: string;\n"
        "  finalizationKeyCommitment: string;\n"
        "  issuedAt: string;",
        "finalization commitment attestation type",
    )
    text = replace_once(
        text,
        "function loadLaunchAttestation(): StateAuthorityLaunchAttestation {",
        CANDIDATE_DIRECTORY_HELPER.strip()
        + "\n\nfunction loadLaunchAttestation(): StateAuthorityLaunchAttestation {",
        "candidate directory resolver",
    )
    text = replace_once(
        text,
        "    || parsed.schemaVersion !== 2\n",
        "    || parsed.schemaVersion !== 3\n",
        "envelope schema",
    )
    text = replace_once(
        text,
        "  if (payload.schemaVersion !== 2) {",
        "  if (payload.schemaVersion !== 3) {",
        "payload schema",
    )
    text = replace_once(
        text,
        "    schemaVersion: 2,\n    runId:",
        "    schemaVersion: 3,\n    runId:",
        "attestation schema",
    )
    text = replace_once(
        text,
        "    campaignExecutionRoot: requiredString(\n      payload,\n      \"campaignExecutionRoot\",\n    ),\n    repositoryCommit:",
        "    campaignExecutionRoot: requiredString(\n"
        "      payload,\n"
        "      \"campaignExecutionRoot\",\n"
        "    ),\n"
        "    candidateReceiptDirectory: resolveCandidateReceiptDirectory(\n"
        "      requiredString(payload, \"candidateReceiptDirectory\"),\n"
        "    ),\n"
        "    repositoryCommit:",
        "candidate directory payload",
    )
    text = replace_once(
        text,
        "    manifestOid: requiredString(payload, \"manifestOid\"),\n    issuedAt:",
        "    manifestOid: requiredString(payload, \"manifestOid\"),\n"
        "    finalizationKeyCommitment: requiredString(\n"
        "      payload,\n"
        "      \"finalizationKeyCommitment\",\n"
        "    ),\n"
        "    issuedAt:",
        "finalization commitment payload",
    )
    text = replace_once(
        text,
        "    || !sha256Pattern.test(attestation.campaignMaterializedSha256)\n",
        "    || !sha256Pattern.test(attestation.campaignMaterializedSha256)\n"
        "    || !sha256Pattern.test(attestation.finalizationKeyCommitment)\n",
        "commitment validation",
    )
    text = regex_replace_once(
        text,
        r"async function attachReceipt\(.*?\n\}\n\ntest\.beforeAll",
        CANDIDATE_WRITER.strip() + "\n\ntest.beforeAll",
        "candidate writer",
    )
    text = replace_once(
        text,
        "test(`${scenario.rw} ${scenario.label} has an independent harm oracle under adverse popup policy @stress`, async ({}, testInfo) => {",
        "test(`${scenario.rw} ${scenario.label} has an independent harm oracle under adverse popup policy @stress`, async () => {",
        "remove testInfo callback",
    )
    text = replace_once(
        text,
        "    await attachReceipt(testInfo, scenario, observations, browserVersion);",
        "    writeReceiptCandidate(scenario, observations, browserVersion);",
        "write candidate call",
    )
    target.write_text(text, encoding="utf-8")


