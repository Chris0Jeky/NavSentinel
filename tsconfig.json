{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@navsentinel/reputation-runtime": [
        "extension/src/shared/reputation_runtime.disabled.ts"
      ],
      "@navsentinel/child-reputation": [
        "extension/src/content/child_reputation.disabled.ts"
      ],
      "@navsentinel/js-behavior-monitor": [
        "extension/src/content/js_behavior_monitor.disabled.ts"
      ]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "types": ["chrome", "node"],
    "skipLibCheck": true
  },
  "include": ["extension/src", "tests", "vite.config.ts", "vitest.config.ts"]
}
