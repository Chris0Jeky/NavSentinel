{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navsentinel.local/schema/security-program/source-provenance.schema.json",
  "title": "NavSentinel supplied-bundle provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_generated",
    "source_bundle_file_count",
    "files",
    "imported_outputs",
    "independently_imported",
    "advertised_but_missing_from_supplied_bundle",
    "note"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "source_generated": { "type": "string", "format": "date" },
    "source_bundle_file_count": { "type": "integer", "minimum": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^RESOURCES/DefenseVectors/" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "imported_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "semantic_sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^docs/security-program/registry/.+\\.json$" },
          "semantic_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "independently_imported": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "advertised_but_missing_from_supplied_bundle": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "note": { "type": "string", "minLength": 1 }
  }
}
