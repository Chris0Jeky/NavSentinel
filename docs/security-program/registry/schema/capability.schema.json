{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navsentinel.local/schema/security-program/capability.schema.json",
  "title": "NavSentinel security programme capability registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "capability_count", "capabilities"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "source": { "type": "string", "minLength": 1 },
    "capability_count": { "type": "integer", "minimum": 0 },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "track",
          "priority",
          "phase",
          "issue_policy",
          "existing_issue_refs",
          "purpose",
          "scope",
          "acceptance",
          "dependencies"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[FCN]-[0-9]{2}$" },
          "title": { "type": "string", "minLength": 1 },
          "track": {
            "enum": [
              "proving_ground",
              "release_integrity",
              "research_extension",
              "native_post_validation",
              "agent_future"
            ]
          },
          "priority": { "enum": ["P0", "P1", "P2", "P3"] },
          "phase": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "issue_policy": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "existing_issue_refs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^#[0-9]+$" },
            "uniqueItems": true
          },
          "purpose": { "type": "string", "minLength": 1 },
          "scope": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[FCN]-[0-9]{2}$" },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
