{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navsentinel.local/schema/security-program/capability-map.schema.json",
  "title": "NavSentinel live capability reconciliation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "as_of", "mapping_count", "mappings"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "as_of": { "type": "string", "format": "date" },
    "mapping_count": { "type": "integer", "minimum": 0 },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "implementation_status",
          "profiles",
          "source_paths",
          "scenarios_served",
          "evidence_state",
          "release_status",
          "permission_privacy",
          "failure_mode",
          "known_limitation",
          "issue_refs",
          "pr_refs"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[FCN]-[0-9]{2}$" },
          "implementation_status": {
            "enum": ["SEEDED", "PARTIAL", "ACTIVE_BOUNDED", "PLANNED", "DESIGN_ONLY", "NOT_IMPLEMENTED"]
          },
          "profiles": {
            "type": "array",
            "items": {
              "enum": [
                "release_extension",
                "research_extension",
                "proving_ground",
                "native_companion",
                "agent_future"
              ]
            },
            "uniqueItems": true
          },
          "source_paths": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "scenarios_served": {
            "type": "array",
            "items": { "type": "string", "pattern": "^(NS-ADV-[A-Z]+-[0-9]{3}|[A-Z]+)$" },
            "uniqueItems": true
          },
          "evidence_state": {
            "enum": [
              "UNMODELLED",
              "MODELLED",
              "FIXTURE_PROVEN",
              "REGRESSION_PROVEN",
              "ROBUSTNESS_PROVEN",
              "BROWSER_PROVEN",
              "EFFICACY_MEASURED",
              "RELEASE_ELIGIBLE"
            ]
          },
          "release_status": {
            "enum": ["FOUNDATION", "BETA_BLOCKER", "RELEASE_ACTIVE", "RESEARCH_ONLY", "POST_BETA", "NATIVE_DEFERRED"]
          },
          "permission_privacy": { "type": "string", "minLength": 1 },
          "failure_mode": { "type": "string", "minLength": 1 },
          "known_limitation": { "type": "string", "minLength": 1 },
          "issue_refs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^(#[0-9]+|private:RI-[0-9]{2})$" },
            "uniqueItems": true
          },
          "pr_refs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^#[0-9]+$" },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
