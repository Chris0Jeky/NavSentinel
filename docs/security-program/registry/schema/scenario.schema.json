{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navsentinel.local/schema/security-program/scenario.schema.json",
  "title": "NavSentinel adversarial scenario registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated", "scenario_count", "scenarios"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "generated": { "type": "string", "format": "date" },
    "scenario_count": { "type": "integer", "minimum": 0 },
    "scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "evidenceState": {
      "enum": [
        "UNMODELLED",
        "MODELLED",
        "FIXTURE_PROVEN",
        "REGRESSION_PROVEN",
        "ROBUSTNESS_PROVEN",
        "BROWSER_PROVEN",
        "EFFICACY_MEASURED",
        "RELEASE_ELIGIBLE"
      ]
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "family_name",
        "title",
        "slug",
        "status",
        "severity",
        "priority",
        "attacker_objective",
        "harm_boundary",
        "necessity_invariant",
        "malicious_fixture",
        "benign_control",
        "mixed_fixture",
        "expected_policy",
        "expected_class",
        "extension_controls",
        "native_controls",
        "legitimate_patterns",
        "primary_signals",
        "mutation_axes",
        "test_lanes",
        "capability_dependencies",
        "existing_issue_refs",
        "safety_constraints",
        "evidence_status",
        "evidence_required",
        "owner",
        "live_issue",
        "last_reviewed"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^NS-ADV-[A-Z]+-[0-9]{3}$" },
        "family": { "type": "string", "pattern": "^[A-Z]+$" },
        "family_name": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "status": { "$ref": "#/$defs/evidenceState" },
        "severity": { "enum": ["S1", "S2", "S3", "S4"] },
        "priority": { "enum": ["P0", "P1", "P2", "P3"] },
        "attacker_objective": { "type": "string", "minLength": 1 },
        "harm_boundary": { "type": "string", "minLength": 1 },
        "necessity_invariant": { "type": "string", "minLength": 1 },
        "malicious_fixture": { "type": "string", "minLength": 1 },
        "benign_control": { "type": "string", "minLength": 1 },
        "mixed_fixture": { "type": "string", "minLength": 1 },
        "expected_policy": { "type": "string", "minLength": 1 },
        "expected_class": {
          "enum": [
            "ADVISE_OR_ANNOTATE",
            "ALLOW",
            "BLOCK_OR_RECOVER",
            "CONTEXTUAL_ALLOW_AND_BLOCK",
            "HOLD_FOR_TRUSTED_DECISION",
            "POLICY_SPECIFIC",
            "PROMPT_OR_HOLD",
            "RECOVER_POST_COMMIT"
          ]
        },
        "extension_controls": { "$ref": "#/$defs/stringList" },
        "native_controls": { "$ref": "#/$defs/stringList" },
        "legitimate_patterns": { "$ref": "#/$defs/stringList" },
        "primary_signals": { "$ref": "#/$defs/stringList" },
        "mutation_axes": { "$ref": "#/$defs/stringList" },
        "test_lanes": { "$ref": "#/$defs/stringList" },
        "capability_dependencies": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[FCN]-[0-9]{2}$" },
          "uniqueItems": true
        },
        "existing_issue_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^#[0-9]+$" },
          "uniqueItems": true
        },
        "safety_constraints": { "$ref": "#/$defs/stringList" },
        "evidence_status": { "$ref": "#/$defs/evidenceState" },
        "evidence_required": { "$ref": "#/$defs/stringList" },
        "owner": { "type": "string" },
        "live_issue": { "type": "string", "pattern": "^(|#[0-9]+)$" },
        "last_reviewed": { "type": "string", "format": "date" }
      }
    }
  }
}
