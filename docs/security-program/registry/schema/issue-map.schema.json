{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navsentinel.local/schema/security-program/issue-map.schema.json",
  "title": "NavSentinel security programme issue deduplication map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "as_of", "repository", "new_issues_created", "scenario_issue_count", "entries"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "as_of": { "type": "string", "format": "date" },
    "repository": { "const": "Chris0Jeky/NavSentinel" },
    "new_issues_created": { "type": "integer", "minimum": 0 },
    "scenario_issue_count": { "type": "integer", "minimum": 0 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["theme", "programme_ids", "issue_refs", "pr_refs", "disposition", "evidence_boundary"],
        "properties": {
          "theme": { "type": "string", "minLength": 1 },
          "programme_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^([FCN]-[0-9]{2}|NS-ADV-[A-Z]+-[0-9]{3})$" },
            "uniqueItems": true
          },
          "issue_refs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^(#[0-9]+|private:RI-[0-9]{2})$" },
            "uniqueItems": true
          },
          "pr_refs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^#[0-9]+$" },
            "uniqueItems": true
          },
          "disposition": { "enum": ["REUSE", "REBODY_WHEN_SCHEDULED", "REGISTRY_ONLY", "PRIVATE_EXISTING_HOME", "DEFER"] },
          "evidence_boundary": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
