{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navsentinel.local/schema/security-program/work-unit-definitions.schema.json",
  "title": "NavSentinel scenario work-unit definitions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "definition_count", "definitions"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "source": { "type": "string", "minLength": 1 },
    "definition_count": { "const": 9 },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["suffix", "title", "exit", "depends_on_suffixes"],
        "properties": {
          "suffix": { "type": "string", "pattern": "^[0-9]{2}-[A-Z]+$" },
          "title": { "type": "string", "minLength": 1 },
          "exit": { "type": "string", "minLength": 1 },
          "depends_on_suffixes": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[0-9]{2}-[A-Z]+$" },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
