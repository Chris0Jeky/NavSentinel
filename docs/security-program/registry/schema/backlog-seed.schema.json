{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navsentinel.local/schema/security-program/backlog-seed.schema.json",
  "title": "NavSentinel local scenario work-unit backlog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_from", "task_count", "tasks"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "generated_from": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "const": "registry/scenarios.json" },
        { "const": "registry/work-unit-definitions.json" }
      ],
      "items": false
    },
    "task_count": { "type": "integer", "minimum": 0 },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scenario_id", "suffix", "title", "exit", "status", "depends_on"],
        "properties": {
          "id": { "type": "string", "pattern": "^NS-ADV-[A-Z]+-[0-9]{3}-[0-9]{2}-[A-Z]+$" },
          "scenario_id": { "type": "string", "pattern": "^NS-ADV-[A-Z]+-[0-9]{3}$" },
          "suffix": { "type": "string", "pattern": "^[0-9]{2}-[A-Z]+$" },
          "title": { "type": "string", "minLength": 1 },
          "exit": { "type": "string", "minLength": 1 },
          "status": { "const": "LOCAL_ONLY" },
          "depends_on": {
            "type": "array",
            "items": { "type": "string", "pattern": "^NS-ADV-[A-Z]+-[0-9]{3}-[0-9]{2}-[A-Z]+$" },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
