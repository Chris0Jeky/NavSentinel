{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent_hooks/session_start.py\"",
            "commandWindows": "$root = git rev-parse --show-toplevel; python \"$root\\scripts\\agent_hooks\\session_start.py\"",
            "timeout": 5,
            "statusMessage": "Loading NavSentinel agent context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/dispatch.py\" --event pre",
            "commandWindows": "$root = git rev-parse --show-toplevel; python \"$root\\.claude\\hooks\\dispatch.py\" --event pre",
            "timeout": 5,
            "statusMessage": "Checking repository command policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent_hooks/post_tool_use.py\"",
            "commandWindows": "$root = git rev-parse --show-toplevel; python \"$root\\scripts\\agent_hooks\\post_tool_use.py\"",
            "timeout": 5,
            "statusMessage": "Checking agentic-tooling changes"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent_hooks/post_tool_failure.py\"",
            "commandWindows": "$root = git rev-parse --show-toplevel; python \"$root\\scripts\\agent_hooks\\post_tool_failure.py\"",
            "timeout": 10,
            "statusMessage": "Capturing sanitized tool failures"
          }
        ]
      }
    ]
  }
}
